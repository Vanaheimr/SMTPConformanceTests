<Project Sdk="Microsoft.NET.Sdk">

  <!-- The entry point is IsolatedProcess.Main: a test runs input that may end its process
       (a stack overflow) in a child process of this assembly. -->
  <PropertyGroup>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.15.0" PrivateAssets="all" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SMTPConformance.Core\SMTPConformance.Core.csproj" />
  </ItemGroup>

</Project>
